{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "namespaceImportPackages": ["effect"],
        "allowedUnstableApis": [
          "effect/Arbitrary",
          "@effect/vitest",
          "effect/Crypto",
          "effect/http/FetchHttpClient",
          "effect/http/HttpClient",
          "effect/http/HttpClientError",
          "effect/http/HttpClientRequest",
          "effect/http/HttpClientResponse",
          "effect/http/HttpServerRequest",
          "effect/http/HttpServerResponse"
        ],
        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "error",
          "unsafeEffectTypeAssertion": "error",
          "floatingEffect": "error",
          "floatingEffectInVitest": "error",
          "missingEffectContext": "error",
          "missingEffectError": "error",
          "missingLayerContext": "error",
          "leakingRequirements": "error",
          "globalErrorInEffectCatch": "error",
          "globalErrorInEffectFailure": "error",
          "unknownInEffectCatch": "error",
          "tryCatchInEffectGen": "error",
          "returnEffectInGen": "error",
          "runEffectInsideEffect": "error",
          "schemaSyncInEffect": "error",
          "instanceOfSchema": "error",
          "newPromise": "error",
          "asyncFunction": "error",
          "globalConsole": "error",
          "globalConsoleInEffect": "error",
          "globalDate": "error",
          "globalDateInEffect": "error",
          "globalFetch": "error",
          "globalFetchInEffect": "error",
          "globalRandom": "error",
          "globalRandomInEffect": "error",
          "globalTimers": "error",
          "globalTimersInEffect": "error",
          "cryptoRandomUUID": "error",
          "cryptoRandomUUIDInEffect": "error",
          "strictEffectProvide": "off",
          "lazyEffect": "off",
          "strictBooleanExpressions": "off"
        }
      }
    ]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
