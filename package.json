{
  "name": "alchemy-analytics",
  "version": "0.0.0",
  "description": "Capture-first, privacy-first request analytics for Alchemy and Effect",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joelhooks/alchemy-analytics.git"
  },
  "files": [
    "dist",
    "README.md",
    "PROVENANCE.md",
    "LICENSE",
    "docs"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./basin": {
      "types": "./dist/basin.d.ts",
      "import": "./dist/basin.js"
    },
    "./ingest": {
      "types": "./dist/ingest.d.ts",
      "import": "./dist/ingest.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "effect-tsgo patch && tsc -p tsconfig.build.json",
    "prepare": "pnpm run build",
    "typecheck": "pnpm build && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.consumer.json",
    "format": "oxfmt --write src test *.ts *.json AGENTS.md README.md PROVENANCE.md docs pnpm-workspace.yaml",
    "lint": "oxfmt --check src test *.ts *.json AGENTS.md README.md PROVENANCE.md docs pnpm-workspace.yaml && oxlint --type-aware",
    "check": "pnpm typecheck && pnpm lint",
    "test": "pnpm build && vitest run",
    "test:consumer": "pnpm build && bash scripts/consumer-test.sh",
    "test:effect": "bash scripts/test-effect-version.sh",
    "test:matrix": "pnpm test:effect 4.1.2"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@cloudflare/workers-types": "5.20261019.1",
    "@effect/platform-node": "4.1.2",
    "@effect/tsgo": "0.54.0",
    "@effect/vitest": "4.1.2",
    "@types/node": "24.19.2",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "ultracite": "8.0.1",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "alchemy": "2.0.0-beta.85",
    "effect": ">=4.1.2 <4.2.0"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/cloudflare": {
      "optional": true
    },
    "alchemy": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@11.3.0"
}
